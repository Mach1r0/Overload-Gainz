# Copie para .env.prod e preencha os valores antes de subir o compose de produção
# docker compose -f docker-compose.prod.yml up -d

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL
DATABASE_URL=postgres://og_user:strongpassword@db:5432/overload_gainz
POSTGRES_DB=overload_gainz
POSTGRES_USER=og_user
POSTGRES_PASSWORD=strongpassword

# Redis
REDIS_URL=redis://redis:6379/1
REDIS_PASSWORD=

# RabbitMQ / Celery
RABBITMQ_USER=og_rabbit
RABBITMQ_PASS=strongrabbitpassword
CELERY_BROKER_URL=amqp://og_rabbit:strongrabbitpassword@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# OpenAI (opcional — IA)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
